# Copy to .env and fill in the platforms you want to use.
# Platforms left blank are reported as "failed: Not configured" in the response.

# --- General ---
TIMEZONE=Asia/Kolkata
HTTP_TIMEOUT_SECONDS=15
PLATFORM_TIMEOUT_SECONDS=30
VERIFY_PUBLIC_ACCESS=true
LOG_LEVEL=INFO
LOG_FILE=logs/posting.log

# --- Telegram: talk to @BotFather -> /newbot; add the bot as admin of a PUBLIC channel ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@your_public_channel

# --- Discord: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL ---
DISCORD_WEBHOOK_URL=

# --- Mastodon: Preferences -> Development -> New application (scope write:statuses) ---
MASTODON_BASE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# --- Bluesky: Settings -> Privacy and security -> App passwords ---
BLUESKY_SERVICE_URL=https://bsky.social
BLUESKY_HANDLE=yourname.bsky.social
BLUESKY_APP_PASSWORD=

# --- DEV Community: https://dev.to/settings/extensions -> Generate API key ---
DEVTO_API_KEY=
DEVTO_TAGS=showdev,webdev

# --- GitHub: fine-grained token with "Gists: Read and write" (or classic token with gist scope) ---
GITHUB_TOKEN=

# --- Pastebin: https://pastebin.com/doc_api (Developer API key) ---
PASTEBIN_API_KEY=
PASTEBIN_USER_KEY=
